/**
 * Cloudflare Workers configuration.
 *
 * The site is a static export (`out/`) served from Cloudflare's asset store,
 * with one tiny Worker in front of it that exists only to choose a language on
 * `/`. There are no bindings beyond the assets themselves — no R2, no KV, no
 * Images, no D1 — because there is nothing here that needs one, and every one of
 * those is a billable product.
 *
 * The whole deployment therefore has a single metered dimension: Worker
 * requests, on `/` only. Everything else is a static asset request, which
 * Cloudflare does not bill.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teuta-apartment",
  "main": "worker/index.ts",
  "compatibility_date": "2025-03-25",

  "assets": {
    // `npm run build` writes the static export here.
    "directory": "./out",
    "binding": "ASSETS",

    /*
      Only `/` wakes the Worker. Everything else is served straight from the
      asset store, which is faster and is not billed as a Worker request.
      Without this the Worker would still be correct — it passes everything
      else to env.ASSETS — but every request would be a billed invocation for
      no reason.
    */
    "run_worker_first": ["/"],

    /*
      The export writes `en.html`, not `en/index.html`, and the canonical URLs
      are `/en` with no trailing slash. This serves en.html at /en and redirects
      /en/ to it, so there is one URL per page rather than two.
    */
    "html_handling": "auto-trailing-slash",

    // Unknown paths get the exported 404 page rather than a bare Cloudflare error.
    "not_found_handling": "404-page"
  },

  "observability": {
    "enabled": true
  }
}
