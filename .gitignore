# Cloudflare / OpenNext build output and local runtime state. All regenerated by
# `npm run cf:build`; none of it belongs in the repository.
.open-next/
.wrangler/
# Local-only Worker vars. Nothing secret lives here today, but this is the file
# Cloudflare's own convention puts secrets in, so it must never be committable.
.dev.vars
# Generated by `npm run cf:typegen` from wrangler.jsonc.
cloudflare-env.d.ts

# Impeccable's skill files are a third-party install, not project source.
# Reinstall with `npx impeccable install`. launch.json is kept: it is ours.
.claude/skills/
.claude/settings.local.json

# Design-hook cache and live-session state: machine-local, rewritten constantly.
# DESIGN.md and .impeccable/design.json ARE project source and stay tracked.
.impeccable/hook.cache.json
.impeccable/hook.pending.json
.impeccable/live/sessions/
.impeccable/live/roots.json
.impeccable/live/server.json
.impeccable/live/inject-journal.json
